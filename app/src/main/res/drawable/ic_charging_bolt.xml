<?xml version="1.0" encoding="utf-8"?><!--
    Charging badge, overlaid on the bottom-end corner of the battery icon.

    A solid dark disc with a light ring and a white bolt glyph. It is NOT
    hue-coded and NOT themed on purpose: the disc can land on the green, orange
    or red battery icon and on a light or dark widget surface, so the cue is
    carried by shape + luminance contrast alone. That also keeps it legible for
    red-green colour-blind users. See the colour comments in values/colors.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="15dp"
    android:height="15dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Disc + ring: stroke is centred on the path, so radius 10.5 with a
         1.5-wide stroke keeps the outer edge inside the 24x24 box. -->
    <path
        android:fillColor="@color/charging_badge_bg"
        android:strokeColor="@color/charging_badge_ring"
        android:strokeWidth="1.5"
        android:pathData="M12,1.5 A10.5,10.5 0 1,0 12,22.5 A10.5,10.5 0 1,0 12,1.5 Z" />

    <!-- Bolt glyph. -->
    <path
        android:fillColor="@color/charging_badge_bolt"
        android:pathData="M13.5,4 L7.5,13 L11,13 L10.5,20 L16.5,10.5 L13,10.5 Z" />
</vector>
