<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <Switch
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:checked="false"
        android:contentDescription="@string/hotspot_accessibility_off"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scaleX="1.16"
        android:scaleY="1.16"
        android:showText="true"
        android:splitTrack="false"
        android:textColor="@color/widget_text"
        android:textOff="@string/hotspot_off"
        android:textOn="@string/hotspot_on"
        android:textSize="18sp"
        android:textStyle="bold"
        android:thumbTint="@color/hotspot_switch_thumb"
        android:trackTint="@color/hotspot_switch_track" />

</FrameLayout>
