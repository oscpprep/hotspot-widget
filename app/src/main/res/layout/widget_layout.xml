<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Hotspot Status Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Defaults are the "unknown" state on purpose: this layout is what the
             system shows before onUpdate has drawn real values. Defaulting to
             "Hotspot Off" / "100%" would render a confident lie whenever the
             update is delayed or lost. -->
        <ImageView
            android:id="@+id/hotspot_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/hotspot_status"
            android:scaleType="centerInside"
            android:src="@drawable/ic_hotspot_unknown" />

        <TextView
            android:id="@+id/hotspot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hotspot_unknown"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:background="@color/divider"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- Battery Status Section (tapping shows the About dialog) -->
    <LinearLayout
        android:id="@+id/battery_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/battery_status"
            android:scaleType="centerInside"
            android:src="@drawable/ic_battery_unknown" />

        <TextView
            android:id="@+id/battery_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_unknown"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
